# Salin ke infra/.env.prod (jangan di-commit) lalu isi. Lihat docs/DEPLOY.md.
# Folder data di host: uploads, wa-auth, secrets/jwt-private.pem, backup.
DATA_DIR=/data
TAG=latest

# openssl rand -base64 32 (masing-masing berbeda)
POSTGRES_PASSWORD=
INTERNAL_KEY=
OPERATOR_JWT_SECRET=

# Token tunnel dari Cloudflare Zero Trust → Networks → Tunnels (public hostname → http://traefik:80)
CLOUDFLARE_TUNNEL_TOKEN=

# baileys = WhatsApp sungguhan (pakai nomor khusus); fake = tanpa WA
WA_DRIVER=baileys

# Integrasi SiKU (fase 8, docs/SIKU.md). Kosong = menu Keuangan (SiKU) tidak tampil.
SIKU_URL=
SIKU_AUDIENCE=siku
