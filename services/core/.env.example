PORT=3001
DATABASE_URL=postgresql://app:app@localhost:5432/core_db
REDIS_URL=redis://localhost:6379

# Kunci bersama untuk endpoint /internal/* (header x-internal-key). Wajib sama di semua service.
INTERNAL_KEY=ganti-dengan-string-acak-panjang

# Kunci privat RS256 untuk JWT. Isi JWT_PRIVATE_KEY (PEM, boleh pakai \n) atau taruh file di
# JWT_PRIVATE_KEY_FILE. Di dev, file dibuat otomatis bila belum ada. Di produksi wajib diisi.
# JWT_PRIVATE_KEY=
JWT_PRIVATE_KEY_FILE=keys/jwt-private.pem
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Integrasi SiKU (fase 8). Alamat web SiKU; kosong = menu "Keuangan (SiKU)" tidak tampil.
# Token masuk SiKU memakai audience SIKU_AUDIENCE (harus sama dengan CORE_SSO_AUDIENCE di SiKU).
SIKU_URL=
SIKU_AUDIENCE=siku

# Akun SUPER_ADMIN dari seed (dev)
SEED_ADMIN_EMAIL=admin@platform-acara.local
SEED_ADMIN_PASSWORD=admin12345
