// wabot-svc — bot WA (Baileys), pengajuan izin, log pesan.
// State percakapan disimpan di Redis (bot:state:{noWa}, TTL 10 menit), bukan di DB.
// Auth state Baileys disimpan di folder WA_AUTH_DIR (produksi: volume /data/wa-auth).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum KategoriIzin {
  IZIN
  SAKIT
}

enum StatusIzin {
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum PengajuTipe {
  ANGGOTA
  WALI
}

enum ArahPesan {
  MASUK
  KELUAR
}

/// Salinan ringkas anggota dari core (event anggota.upserted) untuk mencocokkan nomor WA
/// anggota sendiri atau walinya. Hanya data yang dibutuhkan bot.
model AnggotaRef {
  id           String   @id // = Anggota.id di core
  kode         String   @unique
  nama         String
  kelompokId   String
  desaId       String
  daerahId     String
  namaKelompok String
  namaDesa     String
  status       String
  noWa         String?
  waliNoWa     String[]
  updatedAt    DateTime @db.Timestamptz(3) // dari core, untuk resync
  syncedAt     DateTime @default(now()) @db.Timestamptz(3)

  @@index([noWa])
  @@index([waliNoWa], type: Gin)
}

model Izin {
  id              String       @id @default(cuid())
  nomor           Int          @unique @default(autoincrement()) // tampil sebagai IZ-0123
  anggotaId       String
  /// Salinan saat diajukan (untuk pesan & daftar tanpa memanggil service lain).
  kodeAnggota     String
  namaAnggota     String
  kelompokId      String
  namaKelompok    String
  namaDesa        String
  pengajuNoWa     String
  pengajuTipe     PengajuTipe
  acaraId         String
  acaraNama       String
  sesiId          String
  sesiNama        String
  sesiMulai       DateTime     @db.Timestamptz(3)
  kategori        KategoriIzin
  alasan          String       @db.VarChar(300)
  status          StatusIzin   @default(SUBMITTED)
  /// User core yang diteruskan pengajuan (PJ_IZIN, atau PJ_UMUM bila tidak ada).
  handlerUserIds  String[]
  decidedBy       String?
  decidedByNama   String?
  decidedVia      String? // WA | WEB
  decidedAt       DateTime?    @db.Timestamptz(3)
  catatanPengurus String?      @db.VarChar(300)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  @@index([anggotaId, sesiId])
  @@index([status])
  @@index([kelompokId])
  @@index([pengajuNoWa])
}

model PesanLog {
  id        String    @id @default(cuid())
  noWa      String
  arah      ArahPesan
  isi       String
  izinId    String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([noWa, createdAt])
  @@index([createdAt])
}
