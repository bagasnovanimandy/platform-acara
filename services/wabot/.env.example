PORT=3003
DATABASE_URL=postgresql://app:app@localhost:5432/wabot_db
REDIS_URL=redis://localhost:6379
# core-svc (JWKS & /internal/*) dan acara-svc (/internal/*)
CORE_URL=http://localhost:3001
ACARA_URL=http://localhost:3002
INTERNAL_KEY=ganti-dengan-string-acak-panjang
# baileys = WhatsApp sungguhan; fake = tanpa WA (pengembangan & uji, pesan masuk lewat POST /wa/simulasi)
WA_DRIVER=fake
# Kredensial sesi WhatsApp (produksi: volume /data/wa-auth). Jangan di-commit.
WA_AUTH_DIR=data/wa-auth
