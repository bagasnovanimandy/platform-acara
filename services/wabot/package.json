    "bullmq": "^6.3.17",
    "dotenv": "^18.0.8",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "nestjs-zod": "^5.5.0",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
