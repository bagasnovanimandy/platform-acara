PORT=3002
DATABASE_URL=postgresql://app:app@localhost:5432/acara_db
REDIS_URL=redis://localhost:6379
# core-svc: JWKS untuk verifikasi token & endpoint /internal/*
CORE_URL=http://localhost:3001
INTERNAL_KEY=ganti-dengan-string-acak-panjang
# Foto kegiatan disimpan di <UPLOAD_DIR>/acara/<id>/ (produksi: /data/uploads)
UPLOAD_DIR=data/uploads
# Rahasia token perangkat operator (HS256), minimal 16 karakter
OPERATOR_JWT_SECRET=ganti-dengan-rahasia-operator-panjang
